#!/bin/bash

if hyprctl clients -j | jq -e '.[] | select(.workspace.name == "special:yazi")' >/dev/null; then
  hyprctl dispatch 'hl.dsp.workspace.toggle_special("yazi")'
else
  hyprctl dispatch 'hl.dsp.exec_cmd("kitty -- yazi", { workspace = "special:yazi", float = true, size = { 1920, 1080 }, center = true })'
fi
