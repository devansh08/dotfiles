{
  "height": 36,
  "spacing": 4,
  "margin": 0,
  "reload_style_on_change": true,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/submap",
  ],
  "modules-center": [
    "mpris",
  ],
  "modules-right": [
    "privacy",
    "custom/wireguard",
    "bluetooth",
    "network",
    "pulseaudio",
    "group/hardware",
    "group/clock",
  ],
  "bluetooth": {
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-connected": "󰂱 {device_alias}",
    "format-disabled": "DSBL",
    "max-length": 10,
    "on-click": "kitty --class='kitty_float' bluetui",
    "tooltip": true,
    "tooltip-format-connected": "Device: {device_alias}",
    "tooltip-format-connected-battery": "Device:\t{device_alias}\nCharge:\t{device_battery_percentage}%",
  },
  "group/clock": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 100,
      "children-class": "clock-child",
      "transition-left-to-right": false,
    },
    "modules": [
      "clock",
      "battery",
      "cpu",
      "memory",
      "disk",
      "clock#day",
    ],
  },
  "clock": {
    "interval": 1,
    "format": "󰅐 {:%H:%M:%S}",
    "tooltip": false,
    "actions": {
      "on-click": "gsimplecal",
    },
  },
  "clock#day": {
    "interval": 60,
    "format": "󰻙 {:%a %d, %b}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "left",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#f5e0dc'><b>{}</b></span>",
        "days": "<span color='#74c7ec'>{}</span>",
        "weeks": "<span color='#ffcc66'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#f38ba8'><u><b>{}</b></u></span>"
      }
    },
    "actions": {
      "on-click": "mode",
      "on-scroll-up": "shift_down",
      "on-scroll-down": "shift_up",
    }
  },
  "cpu": {
    "interval": 30,
    "format": " {usage}%",
    "on-click": "kitty --class='kitty_float' btop",
    "tooltip": true,
  },
  "disk": {
    "interval": 120,
    "path": "/",
    "format": " {free}",
    "tooltip": true,
    "tooltip-format": "{used} used of {total}",
  },
  "memory": {
    "interval": 30,
    "format": "󰍛 {used}GiB",
    "tooltip": true,
    "tooltip-format": "{swapUsed}GiB of swap used",
  },
  "pulseaudio": {
    "format": "󰕾 {volume}%",
    "format-muted": "󰝟 0%",
    "scroll-step": 1.0,
    "tooltip": false,
    "on-click-middle": "vol-control mute",
    "on-click": "kitty --class='kitty_float' wiremix",
  },
  "mpris": {
    "interval": 1,
    "player": "cmus",
    "format": " {dynamic}",
    "format-paused": " {dynamic}",
    "max-length": 40,
    "dynamic-order": [
      "title",
      "artist",
    ],
    "dynamic-importance-order": [
      "title",
      "artist",
    ],
    "tooltip": true,
    "tooltip-format": "{title} - {artist}"
  },
  "network": {
    "format-wifi": "󰖩 {essid}",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-disconnected": "󰖪",
    "tooltip": true,
    "tooltip-format-wifi": "Interface:\t{ifname}\nStrength:\t{signalStrength}%\nIP Address:\t{ipaddr}",
    "tooltip-format-ethernet": "Interface:\t{ifname}",
    "on-click": "kitty --class='kitty_float' impala",
  },
  "privacy": {
    "icon-spacing": 4,
    "icon-size": 18,
    "transition-duration": 100,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 0
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 0
      }
    ]
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "format-window-separator": "",
    "show-special": false,
  },
  "hyprland/submap": {
    "format": "{}",
    "tooltip": false,
  },
  "custom/wireguard": {
    "signal": 1,
    "exec": "/home/devansh/.bin/waybar-wireguard -s",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "connected": "󰕥",
      "disconnected": "󰦞",
    },
    "on-click": "/home/devansh/.bin/waybar-wireguard -t && pkill -SIGRTMIN+1 waybar",
  }
}
